# Required. Public HTTP(S) origin of this MirthSpool instance.
# Not secret. Restart required. The .invalid domain is intentionally non-routable.
MIRTHSPOOL_PUBLIC_ORIGIN=https://mirthspool.invalid

# Required. Random secret used to authenticate session cookies. Secret. Restart required.
# Generate at least 32 random characters; never reuse the database password.
MIRTHSPOOL_AUTH_SECRET=replace-with-at-least-32-random-characters

# Required for the one-time first-administrator ceremony. Secret.
# Generate at least 32 random bytes. Never put it in URLs, logs, or screenshots.
MIRTHSPOOL_SETUP_TOKEN=replace-with-at-least-32-random-bytes-base64url

# Optional. Comma-separated IP addresses of explicitly trusted reverse proxies.
# A listed proxy must overwrite X-Forwarded-For and set X-MirthSpool-Forwarded-By
# to its own listed address. Not secret. Restart required. Default: empty.
MIRTHSPOOL_TRUSTED_PROXY_IPS=

# Required. Independent HMAC secret for trusted-proxy address assertions.
MIRTHSPOOL_TRUSTED_PROXY_SECRET=replace-with-at-least-32-random-characters

# Required. Base64-encoded 32-byte AES-256-GCM key for source credentials.
# Secret. Restart required. Generate independently; do not reuse another secret.
APP_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Optional. Positive version recorded in new credential envelopes. Not secret.
# Restart required. Default: 1. Changing it requires a controlled rotation plan.
APP_ENCRYPTION_KEY_VERSION=1

# Optional. Permit source metadata requests to private addresses. Not secret.
# Restart required. Default: false. Enable only for reviewed homelab sources.
MIRTHSPOOL_PRIVATE_SOURCE_ALLOWLIST=

# Optional. Permit cached-media requests to private addresses. Not secret.
# Restart required. Default: false. Enabling private sources does not enable it.
MIRTHSPOOL_PRIVATE_MEDIA_ALLOWLIST=

# Optional comma-separated outbound source ports. Not secret. Restart required.
# Default: 80,443. Add non-standard ports only for reviewed destinations.
MIRTHSPOOL_SOURCE_ALLOWED_PORTS=80,443

# Optional comma-separated outbound cached-media ports. Default: 80,443.
MIRTHSPOOL_MEDIA_ALLOWED_PORTS=80,443

# Required by Docker Compose for PostgreSQL. Secret. Restart required. No safe default.
# Replace this placeholder with at least 24 random characters before starting Compose.
MIRTHSPOOL_DATABASE_PASSWORD=replace-with-at-least-24-random-characters

# Required by web and worker processes. Secret because it contains the database password.
# Compose constructs and injects this value; set it directly only outside Compose.
DATABASE_URL=postgresql://mirthspool:replace-with-a-random-password@127.0.0.1:5432/mirthspool

# Required by web and worker processes. Not secret in the private-network M01 baseline.
# Compose injects redis://redis:6379.
REDIS_URL=redis://127.0.0.1:6379

# Optional. Server listening port. Not secret. Restart required. Default: 3000.
MIRTHSPOOL_PORT=3000

# Optional. Server log threshold. Not secret. Restart required. Default: info.
MIRTHSPOOL_LOG_LEVEL=info

# Optional dependency-check timeout in milliseconds. Not secret. Restart required. Default: 1000.
MIRTHSPOOL_HEALTH_CHECK_TIMEOUT_MS=1000

# Optional worker heartbeat interval in milliseconds. Not secret. Restart required. Default: 10000.
MIRTHSPOOL_WORKER_HEARTBEAT_INTERVAL_MS=10000

# Optional ingestion scheduler interval in milliseconds. Default: 15000.
MIRTHSPOOL_SCHEDULER_INTERVAL_MS=15000

# Optional hard wall-clock limit for one provider run. Default: 60000.
MIRTHSPOOL_INGESTION_MAX_DURATION_MS=60000

# Optional PostgreSQL ingestion-run retention in days. Default: 30.
MIRTHSPOOL_INGESTION_RUN_RETENTION_DAYS=30

# Optional safe maintenance windows. Not secret. Restart required.
# Defaults: audit 365 days, stale sessions 30 days, unreferenced content 30 days.
MIRTHSPOOL_AUDIT_RETENTION_DAYS=365
MIRTHSPOOL_SESSION_RETENTION_DAYS=30
MIRTHSPOOL_ORPHAN_RETENTION_DAYS=30

# Optional BullMQ completed/failed job retention. Defaults: 3600/604800 seconds.
MIRTHSPOOL_COMPLETED_JOB_RETENTION_SECONDS=3600
MIRTHSPOOL_FAILED_JOB_RETENTION_SECONDS=604800

# Optional media cache worker concurrency and absolute storage path.
# Defaults: 2 and /var/lib/mirthspool/media.
MIRTHSPOOL_MEDIA_CACHE_CONCURRENCY=2
MIRTHSPOOL_MEDIA_STORAGE_PATH=/var/lib/mirthspool/media

# Optional bounded duplicate-analysis controls. Restart required.
# Defaults: one worker, 100 narrowed candidates, 20 MB, 16,777,216 pixels,
# and five seconds of decoder processing per static safe raster.
MIRTHSPOOL_DUPLICATE_ANALYSIS_CONCURRENCY=1
MIRTHSPOOL_DUPLICATE_MAX_CANDIDATES=100
MIRTHSPOOL_DUPLICATE_HASH_MAX_BYTES=20000000
MIRTHSPOOL_DUPLICATE_HASH_MAX_PIXELS=16777216
MIRTHSPOOL_DUPLICATE_HASH_TIMEOUT_MS=5000

# Optional loopback host port used only by Docker Compose. Not secret. Default: 3000.
MIRTHSPOOL_HTTP_PORT=3000

# Optional release image references used by compose.release.yaml. Not secret.
# Restart required. Prefer immutable sha256 digest references in production.
# The version defaults are the supported v0.1.0 convenience tags.
MIRTHSPOOL_WEB_IMAGE=ghcr.io/milkman3407/mirth-spool-web@sha256:replace-with-64-hex-digest
MIRTHSPOOL_WORKER_IMAGE=ghcr.io/milkman3407/mirth-spool-worker@sha256:replace-with-64-hex-digest

# Optional. Runtime mode. Not secret. Restart required. Default: development.
NODE_ENV=development

# Disables framework telemetry in every environment. Not secret. Restart required.
NEXT_TELEMETRY_DISABLED=1
