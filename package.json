{
  "name": "mirthspool",
  "version": "0.1.2",
  "private": true,
  "description": "Private, self-hosted content aggregator",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs --follow --tail=200",
    "compose:reset": "docker compose down --volumes --remove-orphans",
    "compose:up": "docker compose up --build --detach",
    "docs:check": "node scripts/check-docs.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && node scripts/check-server-only-imports.mjs",
    "release:acceptance": "bash scripts/release-acceptance.sh",
    "release:verify": "node scripts/verify-release.mjs",
    "test": "vitest run",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:e2e": "node scripts/run-e2e-tests.mjs",
    "test:e2e:release": "MIRTHSPOOL_E2E_RELEASE_IMAGES=true node scripts/run-e2e-tests.mjs",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.tests.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "10.0.1",
    "@mirthspool/connectors": "workspace:*",
    "@mirthspool/db": "workspace:*",
    "@mirthspool/redis": "workspace:*",
    "@mirthspool/shared": "workspace:*",
    "@mirthspool/storage": "workspace:*",
    "@playwright/test": "1.58.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.13.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "10.7.0",
    "jsdom": "27.0.1",
    "prettier": "3.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
